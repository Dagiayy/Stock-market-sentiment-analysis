# Copy to .env and fill in as needed. Every value has a safe default in
# src/stock_sentiment/config.py -- nothing here is required to run the
# pipeline, tests, or API with synthetic data.

# --- AI-generated narrative summaries (optional) -----------------------------
# Leave unset to get deterministic template summaries instead of LLM ones.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_INSIGHTS_ENABLED=true

# --- Filesystem paths (defaults are relative to the repo root) --------------
# DATA_DIR=./data
# RAW_NEWS_PATH=./data/raw_analyst_ratings.csv
# RAW_PRICES_DIR=./data/yfinance_data
# DUCKDB_PATH=./data/processed/analytics.duckdb

# --- Sentiment engine ---------------------------------------------------------
# SENTIMENT_BACKEND=vader   # vader | textblob

# --- API -----------------------------------------------------------------------
# API_CORS_ORIGINS=["*"]
# API_RATE_LIMIT_PER_MINUTE=60

# --- Observability ---------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_JSON=false
